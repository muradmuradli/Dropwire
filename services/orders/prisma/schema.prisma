datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Only the saga's first step is implemented so far: place an order, call inventory's
// ReserveStock, record the outcome. RESERVED/CANCELLED/RESERVATION_FAILED is as far as that
// goes today — PaymentConfirmed/PaymentFailed/OrderConfirmed will add more states once the
// rest of the saga (and the events that drive it) exist.
enum OrderStatus {
  PLACED
  RESERVED
  CANCELLED
  // The gRPC call to inventory itself failed (not a business "no" — a transport/infra
  // problem), even after retrying. Distinct from CANCELLED, which means inventory
  // answered and said no. See docs/decisions/0012.
  RESERVATION_FAILED
}

model Order {
  id            String      @id @default(uuid())
  // The JWT `sub` claim, per the root CLAUDE.md's "no local user tables" rule — not yet
  // wired to a real verified token, see services/orders/CLAUDE.md.
  customerId    String
  correlationId String
  status        OrderStatus
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id])
  orderId   String
  productId String
  quantity  Int
}
