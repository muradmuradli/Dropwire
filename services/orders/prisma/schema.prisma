datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// The saga's second step (consuming PaymentConfirmed/PaymentFailed, see
// docs/decisions/0015) adds CONFIRMED — the happy-path terminus. CANCELLED now covers two
// different triggers (inventory declining the reservation synchronously, or a later
// PaymentFailed event) — see docs/decisions/0015 for why that's one status, not two.
enum OrderStatus {
  PLACED
  RESERVED
  CANCELLED
  CONFIRMED
  // The gRPC call to inventory itself failed (not a business "no" — a transport/infra
  // problem), even after retrying. Distinct from CANCELLED, which means inventory
  // answered and said no. See docs/decisions/0012.
  RESERVATION_FAILED
}

model Order {
  id            String      @id @default(uuid())
  // The JWT `sub` claim, per the root CLAUDE.md's "no local user tables" rule — not yet
  // wired to a real verified token, see services/orders/CLAUDE.md.
  customerId    String
  correlationId String
  status        OrderStatus
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([customerId])
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id])
  orderId   String
  productId String
  quantity  Int
}

// The transactional outbox (root CLAUDE.md's rule) — same pattern as inventory's/payments',
// see docs/decisions/0013.
model OutboxMessage {
  id            String    @id @default(uuid())
  type          String
  version       Int       @default(1)
  occurredAt    DateTime  @default(now())
  correlationId String
  payload       Json
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt])
}
