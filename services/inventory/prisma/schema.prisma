datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

// Overall outcome of one order's reservation attempt. PENDING is written before the
// Redis step runs, so a crash mid-reservation leaves a durable, idempotent marker
// instead of silently losing track of the attempt (see docs/decisions/0011).
enum ReservationStatus {
  PENDING
  RESERVED
  OUT_OF_STOCK
  PRODUCT_NOT_FOUND
  RELEASED
}

// Per-item diagnostic recorded alongside the overall status — an item can read
// RESERVED here even when the order as a whole failed, since reservation is
// all-or-nothing per docs/decisions/0007.
enum ReservationItemStatus {
  RESERVED
  OUT_OF_STOCK
  PRODUCT_NOT_FOUND
}

model Stock {
  productId     String   @id
  totalQuantity Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Reservation {
  orderId       String            @id
  correlationId String
  status        ReservationStatus
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         ReservationItem[]
}

model ReservationItem {
  id                       Int                   @id @default(autoincrement())
  reservation              Reservation           @relation(fields: [orderId], references: [orderId])
  orderId                  String
  productId                String
  quantity                 Int
  status                   ReservationItemStatus
  // Only meaningful when status == OUT_OF_STOCK (mirrors the proto's available_quantity).
  availableQuantityAtCheck Int?

  @@index([orderId])
}

// The transactional outbox (root CLAUDE.md's rule): a row here is written in the same
// Postgres transaction as the business write it's reporting on, so "the reservation
// succeeded" and "there's now a durable record to publish" can never disagree — even if
// the relay (OutboxRelayService) or Kafka itself is down when the write happens. Rows are
// marked `publishedAt`, never deleted — see docs/decisions/0013.
model OutboxMessage {
  id            String    @id @default(uuid())
  // Matches the event envelope in contracts/events/envelope.schema.json — this row *is*
  // the envelope, published verbatim by the relay.
  type          String
  version       Int       @default(1)
  occurredAt    DateTime  @default(now())
  correlationId String
  payload       Json
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt])
}
