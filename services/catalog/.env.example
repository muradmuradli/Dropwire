PORT=3001
DATABASE_URL="postgresql://catalog:catalog@localhost:5433/catalog?schema=public"
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dropwire

# Product image uploads (docs/decisions/0030) — presigned S3 PutObject URLs, filled in once the
# bucket exists. S3_PUBLIC_BASE_URL is optional (e.g. a CloudFront domain in front of the bucket);
# left unset, uploaded image URLs fall back to the bucket's own https://<bucket>.s3.<region>.amazonaws.com form.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
