PORT=3004
DATABASE_URL="postgresql://payments:payments@localhost:5436/payments?schema=public"
KAFKA_BROKERS="localhost:19092"
WEB_ORIGIN=http://localhost:3100

# Stripe test-mode secret key (sk_test_...) and the signing secret for this webhook endpoint
# (whsec_..., from `stripe listen` locally or the Dashboard in a deployed environment). Leave
# blank to let the service boot without ever calling Stripe — see docs/decisions/0034.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Flat per-unit test price in cents — there's no real price anywhere in the saga to charge yet.
STRIPE_DUMMY_UNIT_PRICE_CENTS=500
