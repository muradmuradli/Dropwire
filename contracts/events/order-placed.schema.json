{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dropwire.dev/schemas/order-placed.schema.json",
  "title": "OrderPlaced",
  "description": "Topic: order.placed. Producer: orders. Consumer(s): inventory.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "type": { "const": "OrderPlaced" },
        "payload": {
          "type": "object",
          "required": ["orderId", "customerId", "items"],
          "properties": {
            "orderId": { "type": "string", "format": "uuid" },
            "customerId": {
              "type": "string",
              "description": "The JWT `sub` claim — see docs/auth.md. No local user tables anywhere."
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "order-item.schema.json" }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
